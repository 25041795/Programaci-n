def registrar_venta():
    print("\n⊹ Registrar venta ⊹")

    id_cliente = input("ID cliente: ")
    codigo = input("Código producto: ")
    cantidad = int(input("Cantidad: "))
    fecha = datetime.now().strftime("%Y-%m-%d")

    cursor.execute("SELECT precio, cantidad, vendidos FROM productos WHERE codigo=%s", (codigo,))
    prod = cursor.fetchone()

    if not prod:
        print("Producto no encontrado")
        return

    precio, stock, vendidos = prod
    disponibles = stock - vendidos

    if cantidad > disponibles:
        print("No hay suficiente stock")
        return

    total = cantidad * precio

    cursor.execute(
        "UPDATE productos SET vendidos = vendidos + %s WHERE codigo=%s",
        (cantidad, codigo)
    )

    cursor.execute("""
        INSERT INTO ventas
        (id_cliente, codigo_producto, fecha, cantidad, total)
